# ==============================================================================
# YojanaLens AI — Environment Configuration Template (.env.example)
# Never commit real credentials or actual secrets to version control.
# ==============================================================================

# Slot 1: Primary Model (Google Gemini API via @google/genai)
# AI Studio automatically injects GEMINI_API_KEY from user secrets.
GEMINI_API_KEY=""
PRIMARY_MODEL_ID="gemini-3.8-flash"

# Slot 2: Secondary Open-Weight Provider (Ollama Chat API - Optional)
# Host your own Ollama instance or use a reachable hosted server endpoint.
# Cleanly disabled if OLLAMA_BASE_URL is left empty.
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.2"
OLLAMA_API_KEY=""

# Slot 3: Tertiary Open-Weight Provider (Hugging Face Inference - Optional)
# Cleanly disabled if HF_TOKEN is left empty.
HF_TOKEN=""
HF_MODEL_ID="meta-llama/Llama-3.2-3B-Instruct"
HF_INFERENCE_ENDPOINT="https://router.huggingface.co/hf-inference/v1/chat/completions"

# Backward Compatibility Aliases for generic inference proxies (Optional)
FALLBACK_A_ENDPOINT=""
FALLBACK_A_API_KEY=""
FALLBACK_A_MODEL_ID=""
FALLBACK_B_ENDPOINT=""
FALLBACK_B_API_KEY=""
FALLBACK_B_MODEL_ID=""

# Application Host & Port Settings
APP_URL=""
PORT=3000

